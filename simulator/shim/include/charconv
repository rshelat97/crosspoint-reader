#pragma once
// Shim over the toolchain's <charconv>: libc++ (Emscripten) did not implement
// the floating-point std::from_chars overloads until LLVM 20, but the firmware
// CSS parser uses them. When the feature-test macro says they are missing,
// provide strtof/strtod-backed fallbacks (adequate here: the simulator always
// runs in the "C" locale). Native libstdc++ builds have the real thing and the
// fallback compiles away.
#include_next <charconv>

#if defined(_LIBCPP_VERSION) && !defined(__cpp_lib_to_chars)

#include <cerrno>
#include <cstdlib>
#include <cstring>

namespace std {

namespace simshim_detail {
template <typename T, typename Fn>
inline from_chars_result fromCharsFloat(const char* first, const char* last, T& value, Fn strtoFn) {
  char buf[64];
  size_t len = static_cast<size_t>(last - first);
  if (len >= sizeof(buf)) len = sizeof(buf) - 1;
  memcpy(buf, first, len);
  buf[len] = '\0';
  // from_chars accepts no leading whitespace or "0x" prefixes; strto* does.
  // CSS numeric tokens never contain either, so a prefix check suffices.
  if (len == 0 || buf[0] == ' ' || buf[0] == '\t') return {first, errc::invalid_argument};
  char* end = nullptr;
  errno = 0;
  T parsed = strtoFn(buf, &end);
  if (end == buf) return {first, errc::invalid_argument};
  if (errno == ERANGE) return {first + (end - buf), errc::result_out_of_range};
  value = parsed;
  return {first + (end - buf), errc{}};
}
}  // namespace simshim_detail

inline from_chars_result from_chars(const char* first, const char* last, float& value) {
  return simshim_detail::fromCharsFloat(first, last, value, strtof);
}
inline from_chars_result from_chars(const char* first, const char* last, double& value) {
  return simshim_detail::fromCharsFloat(first, last, value, strtod);
}

}  // namespace std

#endif
